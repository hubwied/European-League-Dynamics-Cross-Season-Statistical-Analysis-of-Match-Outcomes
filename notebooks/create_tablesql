    away_shots_avg_last_5 TEXT,
    home_shots_target_avg_last_5 TEXT,
    away_shots_target_avg_last_5 TEXT,
    home_red_cards_avg_last_5 TEXT,
    away_red_cards_avg_last_5 TEXT,
    home_goals_conceded_avg_last_5 TEXT,
    away_goals_conceded_avg_last_5 TEXT,
    target INTEGER,
    home_points INTEGER,
    away_points INTEGER,
